+/// 把 parse 輸出依序轉成 LogEntry；host 依「batch 內輸出順序」分配 id（與整批路徑同規則）。
+fn assemble_parsed_batch(seq: u64, parsed: impl IntoIterator<Item = ParsedEntry>) -> ParsedBatch {
+    let (entries, targettags): (Vec<LogEntry>, Vec<String>) = parsed
+        .into_iter()
+        .enumerate()
+        .map(|(i, p)| {
+            let e = LogEntry {
+                id: seq * 100_000 + i as u64,
+                timestamp: p.timestamp,
+                level: p.level,
+                message: p.message,
+                tags: p.tags,
+            };
+            (e, p.targettag)
+        })
+        .unzip();
+    ParsedBatch { entries, targettags, seq }
+}
+
+/// parse 子呼叫 backend：持有從 pool 取出的 instance，trap 時丟棄並向 pool 取新的。
+struct ParseSubcallBackend<'a> {
+    pool: &'a mut ParsePool,
+    inst: Option<ParseInstance>,
+    deadline_ticks: u64,
+}
+
+impl SubcallBackend<String> for ParseSubcallBackend<'_> {
+    type Out = Vec<ParsedEntry>;
+    type Err = crate::app::local::log_process::pipeline_process::ParseError;
+
+    fn call(&mut self, chunk: &[String]) -> wasmtime::Result<Result<Self::Out, Self::Err>> {
+        let inst = self
+            .inst
+            .as_mut()
+            .ok_or_else(|| wasmtime::Error::msg("no parse instance available"))?;
+        inst.store.set_epoch_deadline(self.deadline_ticks);
+        inst.plugin.call_parse(&mut inst.store, chunk)
+    }
+
+    fn reset(&mut self) -> wasmtime::Result<()> {
+        if let Some(old) = self.inst.take() {
+            self.pool.discard_and_replenish(old);
+        }
+        let mut fresh = self.pool.acquire()?;
+        fresh.store.data_mut().limiter.reset_batch_stats();
+        self.inst = Some(fresh);
+        Ok(())
+    }
+}
+
+/// plugin_call_size 生效時的 parse 路徑：同一個 instance 依序處理所有子呼叫，
+/// 失敗的子呼叫只丟棄自己的記錄；batch 結束後與原路徑一樣丟棄 instance 並補充 pool。
+fn worker_flush_batch_subcalls(
+    worker_id: usize,
+    pool: &mut ParsePool,
+    batch: &mut Batch,
+    seq: u64,
+    stats: &mut ParseStats,
+    tx: &SyncSender<ParsedBatch>,
+    error_count: &mut u32,
+    max_retries: u32,
+    deadline_ticks: u64,
+    call_size: usize,
+) -> bool {
+    let mut first = match pool.acquire() {
+        Ok(i) => i,
+        Err(e) => {
+            eprintln!("[worker{}][pool] cannot acquire (batch={}): {}", worker_id, seq, e);
+            batch.clear();
+            return true;
+        }
+    };
+    first.store.data_mut().limiter.reset_batch_stats();
+
+    let input_lines = batch.len();
+    let input_bytes = batch.bytes;
+    let mut backend = ParseSubcallBackend { pool, inst: Some(first), deadline_ticks };
+    let report = run_subcalls(&batch.lines, call_size, false, max_retries, &mut backend);
+
+    let (wasm_mem_peak, grow_count, grow_delta_bytes) = backend
+        .inst
+        .as_ref()
+        .map(|i| {
+            let l = &i.store.data().limiter;
+            (l.wasm_mem_peak, l.grow_count, l.grow_total_delta_bytes)
+        })
+        .unwrap_or((0, 0, 0));
+    if let Some(inst) = backend.inst.take() {
+        backend.pool.discard_and_replenish(inst);
+    }
+
+    if !report.failed.is_empty() {
+        let traps: Vec<std::ops::Range<usize>> = report
+            .failed
+            .iter()
+            .filter(|(_, f)| matches!(f, SubcallFailure::Trap(_)))
+            .map(|(r, _)| r.clone())
+            .collect();
+        let first_msg = match &report.failed[0].1 {
+            SubcallFailure::Plugin(m) => format!("plugin-error {m}"),
+            SubcallFailure::Trap(m) => format!("trap {m}"),
+        };
+        // 每個 batch 只輸出一行彙總，避免逐筆 stderr 影響延遲。
+        eprintln!(
+            "[worker{}][parse-subcall] batch={} rejected {}/{} records in {} sub-calls (k={}, traps={}) first: {}",
+            worker_id,
+            seq,
+            report.failed_records(),
+            input_lines,
+            report.failed.len(),
+            call_size,
+            traps.len(),
+            first_msg,
+        );
+        if !traps.is_empty() {
+            *error_count += traps.len() as u32;
+            let trapped: Vec<String> = traps
+                .iter()
+                .flat_map(|r| batch.lines[r.clone()].iter().cloned())
+                .collect();
+            write_error_file("以下這些子呼叫發生trap/timeout", &trapped);
+        }
+    }
+
+    let pb = assemble_parsed_batch(seq, report.ok.into_iter().flat_map(|(_, v)| v));
+
+    stats.total_batches += 1;
+    stats.total_input_lines += input_lines as u64;
+    stats.total_input_bytes += input_bytes as u64;
+    stats.total_output_entries += pb.entries.len() as u64;
+    stats.total_grow_count += grow_count;
+    stats.total_grow_delta_bytes += grow_delta_bytes;
+    if wasm_mem_peak > stats.wasm_mem_peak_max {
+        stats.wasm_mem_peak_max = wasm_mem_peak;
+    }
+
+    batch.clear();
+    if pb.entries.is_empty() {
+        return true;
+    }
+    tx.send(pb).is_ok()
+}
