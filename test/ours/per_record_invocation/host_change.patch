+// ── plugin_call_size：把一個 batch 切成多次 plugin 子呼叫 ─────────────────────
+//
+// host 照常累積、flush batch（batching 與延遲語意不變），只是在呼叫 plugin 時
+// 把 batch 切成最多 k 筆的子呼叫，並在「同一個」instance 上連續呼叫。
+// 子呼叫之間錯誤彼此隔離：某個子呼叫回傳 Err 或 trap，只丟棄該子呼叫的記錄。
+// k=1 即逐筆呼叫（per-record invocation with instance reuse）。
+
+/// 是否需要切成子呼叫：k>0 且 batch 筆數大於 k。
+/// k=0（預設）或 batch ≤ k 時維持原本整批一次呼叫的路徑。
+fn needs_split(len: usize, call_size: usize) -> bool {
+    call_size > 0 && len > call_size
+}
+
+/// 把 len 筆記錄切成每段最多 call_size 筆的連續區間（call_size=0 ＝整批一段）。
+fn subcall_ranges(len: usize, call_size: usize) -> impl Iterator<Item = std::ops::Range<usize>> {
+    let step = if call_size == 0 { len.max(1) } else { call_size };
+    (0..len).step_by(step).map(move |start| start..(start + step).min(len))
+}
+
+/// 子呼叫的 plugin 端抽象：正式環境為 WASM instance，單元測試以 mock 取代。
+trait SubcallBackend<In> {
+    type Out;
+    type Err: std::fmt::Debug;
+    /// 以目前的 instance 呼叫一次 plugin。外層 Err ＝ trap／timeout，內層 Err ＝ plugin 回報的錯誤。
+    fn call(&mut self, chunk: &[In]) -> wasmtime::Result<Result<Self::Out, Self::Err>>;
+    /// 丟棄目前（可能已污染的）instance，換上一個新的。
+    fn reset(&mut self) -> wasmtime::Result<()>;
+}
+
+#[derive(Debug)]
+enum SubcallFailure {
+    /// plugin 回傳 Err（例如 malformed JSON）。
+    Plugin(String),
+    /// trap／epoch timeout，或換 instance 失敗。
+    Trap(String),
+}
+
+struct SubcallReport<Out> {
+    /// 成功的子呼叫（依輸入順序）。
+    ok: Vec<(std::ops::Range<usize>, Out)>,
+    /// 失敗的子呼叫（依輸入順序），其記錄被丟棄。
+    failed: Vec<(std::ops::Range<usize>, SubcallFailure)>,
+}
+
+impl<Out> SubcallReport<Out> {
+    fn failed_records(&self) -> usize {
+        self.failed.iter().map(|(r, _)| r.len()).sum()
+    }
+}
+
+/// 依 call_size 逐段呼叫 backend。
+/// - trap：換新 instance 後重試同一段，最多 max_retries 次；仍失敗則只丟棄該段。
+/// - plugin Err：retry_plugin_error=true 時換新 instance 後重試（filter 的原行為是重建後重試），
+///   否則（parse：錯誤由資料決定，重試無意義）直接丟棄該段、instance 繼續使用。
+fn run_subcalls<In, B: SubcallBackend<In>>(
+    items: &[In],
+    call_size: usize,
+    retry_plugin_error: bool,
+    max_retries: u32,
+    backend: &mut B,
+) -> SubcallReport<B::Out> {
+    let mut report = SubcallReport { ok: Vec::new(), failed: Vec::new() };
+    for range in subcall_ranges(items.len(), call_size) {
+        let chunk = &items[range.clone()];
+        let mut attempt = 0;
+        loop {
+            match backend.call(chunk) {
+                Ok(Ok(out)) => {
+                    report.ok.push((range.clone(), out));
+                    break;
+                }
+                Ok(Err(e)) => {
+                    if retry_plugin_error && attempt < max_retries {
+                        attempt += 1;
+                        if let Err(re) = backend.reset() {
+                            report.failed.push((
+                                range.clone(),
+                                SubcallFailure::Trap(format!("reset failed: {re}")),
+                            ));
+                            break;
+                        }
+                        continue;
+                    }
+                    report.failed.push((range.clone(), SubcallFailure::Plugin(format!("{e:?}"))));
+                    break;
+                }
+                Err(trap) => {
+                    // trap 後 instance 狀態不可信：一律換新，後續子呼叫才能繼續。
+                    let reset = backend.reset();
+                    if attempt < max_retries && reset.is_ok() {
+                        attempt += 1;
+                        continue;
+                    }
+                    let msg = match reset {
+                        Ok(()) => format!("{trap}"),
+                        Err(re) => format!("{trap}; reset failed: {re}"),
+                    };
+                    report.failed.push((range.clone(), SubcallFailure::Trap(msg)));
+                    break;
+                }
+            }
+        }
+    }
+    report
+}
