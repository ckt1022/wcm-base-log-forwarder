+// ── 單元測試：plugin_call_size 子呼叫 ─────────────────────────────────────────
+
+#[cfg(test)]
+mod subcall_tests {
+    use super::*;
+    use crate::app::local::log_process::pipeline_process::LogLevel;
+
+    fn ranges(len: usize, k: usize) -> Vec<std::ops::Range<usize>> {
+        subcall_ranges(len, k).collect()
+    }
+
+    #[test]
+    fn ranges_cover_input_in_order() {
+        assert_eq!(ranges(10, 3), vec![0..3, 3..6, 6..9, 9..10]);
+        assert_eq!(ranges(10, 1).len(), 10);
+        assert_eq!(ranges(10, 0), vec![0..10]);
+        assert_eq!(ranges(10, 10), vec![0..10]);
+        assert_eq!(ranges(10, 64), vec![0..10]);
+        assert!(ranges(0, 0).is_empty());
+        assert!(ranges(0, 4).is_empty());
+        // 任意 k：區間連續、不重疊、總和等於 len
+        for len in 0..40 {
+            for k in 0..12 {
+                let rs = ranges(len, k);
+                let mut next = 0;
+                for r in &rs {
+                    assert_eq!(r.start, next);
+                    assert!(r.end > r.start);
+                    if k > 0 {
+                        assert!(r.len() <= k);
+                    }
+                    next = r.end;
+                }
+                assert_eq!(next, len);
+            }
+        }
+    }
+
+    #[test]
+    fn split_only_when_batch_exceeds_k() {
+        assert!(!needs_split(1000, 0)); // 0 = 原行為
+        assert!(!needs_split(16, 16));
+        assert!(!needs_split(3, 16));
+        assert!(needs_split(17, 16));
+        assert!(needs_split(2, 1));
+        assert!(!needs_split(1, 1));
+    }
+
+    /// 模擬 parser：整批中任一行是 "bad" 就回傳 Err（與正式 Rust/C parser 相同語意）；
+    /// "trap" 行在前 `traps_left` 次呼叫時 trap。
+    struct MockParser {
+        calls: usize,
+        resets: usize,
+        traps_left: usize,
+        call_sizes: Vec<usize>,
+    }
+
+    impl MockParser {
+        fn new(traps_left: usize) -> Self {
+            Self { calls: 0, resets: 0, traps_left, call_sizes: Vec::new() }
+        }
+    }
+
+    fn entry(msg: &str) -> ParsedEntry {
+        ParsedEntry {
+            timestamp: "t".to_string(),
+            level: LogLevel::Warn,
+            message: msg.to_string(),
+            tags: vec![("k".to_string(), msg.to_string())],
+            targettag: format!("T-{msg}"),
+        }
+    }
+
+    impl SubcallBackend<String> for MockParser {
+        type Out = Vec<ParsedEntry>;
+        type Err = String;
+        fn call(&mut self, chunk: &[String]) -> wasmtime::Result<Result<Self::Out, Self::Err>> {
+            self.calls += 1;
+            self.call_sizes.push(chunk.len());
+            if chunk.iter().any(|l| l == "trap") && self.traps_left > 0 {
+                self.traps_left -= 1;
+                return Err(wasmtime::Error::msg("wasm trap: unreachable"));
+            }
+            if chunk.iter().any(|l| l == "bad") {
+                return Ok(Err("JSON Parse Error".to_string()));
+            }
+            Ok(Ok(chunk.iter().map(|l| entry(l)).collect()))
+        }
+        fn reset(&mut self) -> wasmtime::Result<()> {
+            self.resets += 1;
+            Ok(())
+        }
+    }
+
+    fn lines(v: &[&str]) -> Vec<String> {
+        v.iter().map(|s| s.to_string()).collect()
+    }
+
+    fn messages(report: SubcallReport<Vec<ParsedEntry>>) -> Vec<String> {
+        report.ok.into_iter().flat_map(|(_, v)| v).map(|e| e.message).collect()
+    }
+
+    #[test]
+    fn per_record_calls_isolate_malformed_lines() {
+        let input = lines(&["a", "bad", "b", "c", "bad", "d"]);
+        let mut p = MockParser::new(0);
+        let report = run_subcalls(&input, 1, false, 1, &mut p);
+        assert_eq!(p.calls, 6, "k=1 → 每筆一次呼叫");
+        assert_eq!(p.resets, 0, "plugin Err 不換 instance（同一 instance 持續使用）");
+        assert_eq!(report.failed_records(), 2);
+        assert!(matches!(report.failed[0].1, SubcallFailure::Plugin(_)));
+        assert_eq!(report.failed[0].0, 1..2);
+        assert_eq!(report.failed[1].0, 4..5);
+        assert_eq!(messages(report), vec!["a", "b", "c", "d"]);
+    }
+
+    #[test]
+    fn whole_batch_call_loses_everything_on_one_bad_line() {
+        // k=0 走同一個 helper 時的語意（正式程式 k=0 不經過此 helper，此處僅示範差異）
+        let input = lines(&["a", "bad", "b", "c"]);
+        let mut p = MockParser::new(0);
+        let report = run_subcalls(&input, 0, false, 1, &mut p);
+        assert_eq!(p.calls, 1);
+        assert_eq!(report.failed_records(), 4);
+        assert!(report.ok.is_empty());
+    }
+
+    #[test]
+    fn small_k_only_drops_the_contaminated_subcall() {
+        let input = lines(&["a", "b", "c", "bad", "d", "e", "f", "g", "h"]);
+        let mut p = MockParser::new(0);
+        let report = run_subcalls(&input, 4, false, 1, &mut p);
+        assert_eq!(p.call_sizes, vec![4, 4, 1]);
+        assert_eq!(report.failed.len(), 1);
+        assert_eq!(report.failed[0].0, 0..4);
+        assert_eq!(messages(report), vec!["d", "e", "f", "g", "h"]);
+    }
+
+    #[test]
+    fn transient_trap_is_retried_on_a_fresh_instance() {
+        let input = lines(&["a", "trap", "b"]);
+        let mut p = MockParser::new(1); // 只 trap 一次
+        let report = run_subcalls(&input, 1, false, 1, &mut p);
+        assert_eq!(p.resets, 1);
+        assert!(report.failed.is_empty());
+        assert_eq!(messages(report), vec!["a", "trap", "b"]);
+    }
+
+    #[test]
+    fn persistent_trap_drops_only_that_subcall_and_continues() {
+        let input = lines(&["a", "trap", "b", "c"]);
+        let mut p = MockParser::new(usize::MAX); // 永遠 trap
+        let report = run_subcalls(&input, 1, false, 1, &mut p);
+        // 第一次 trap → reset + 重試；第二次 trap → reset（讓後續子呼叫用乾淨 instance）後放棄
+        assert_eq!(p.resets, 2);
+        assert_eq!(report.failed.len(), 1);
+        assert!(matches!(report.failed[0].1, SubcallFailure::Trap(_)));
+        assert_eq!(messages(report), vec!["a", "b", "c"]);
+    }
+
+    /// 模擬 filter：前 `errors_left` 次呼叫回傳 Err，之後正常（保留 warn 以上）。
+    struct MockFilter {
+        errors_left: usize,
+        resets: usize,
+    }
+
+    impl SubcallBackend<u64> for MockFilter {
+        type Out = Vec<(u64, bool)>;
+        type Err = String;
+        fn call(&mut self, chunk: &[u64]) -> wasmtime::Result<Result<Self::Out, Self::Err>> {
+            if self.errors_left > 0 {
+                self.errors_left -= 1;
+                return Ok(Err("processing-failed".to_string()));
+            }
+            Ok(Ok(chunk.iter().map(|id| (*id, id % 2 == 0)).collect()))
+        }
+        fn reset(&mut self) -> wasmtime::Result<()> {
+            self.resets += 1;
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn filter_plugin_error_is_retried_like_the_batch_path() {
+        let ids: Vec<u64> = (0..6).collect();
+        let mut f = MockFilter { errors_left: 2, resets: 0 };
+        let report = run_subcalls(&ids, 2, true, 2, &mut f);
+        assert_eq!(f.resets, 2);
+        assert!(report.failed.is_empty());
+        let kept: Vec<u64> = report
+            .ok
+            .iter()
+            .flat_map(|(_, v)| v.iter())
+            .filter(|(_, keep)| *keep)
+            .map(|(id, _)| *id)
+            .collect();
+        assert_eq!(kept, vec![0, 2, 4]);
+
+        // 重試次數用盡：只丟棄該子呼叫
+        let mut f = MockFilter { errors_left: 3, resets: 0 };
+        let report = run_subcalls(&ids, 2, true, 2, &mut f);
+        assert_eq!(report.failed.len(), 1);
+        assert_eq!(report.failed[0].0, 0..2);
+        assert_eq!(report.ok.len(), 2);
+    }
+
+    #[test]
+    fn host_ids_are_contiguous_and_order_is_kept_across_subcalls() {
+        let input = lines(&["a", "b", "bad", "c", "d", "e", "bad", "f"]);
+        let mut p = MockParser::new(0);
+        let report = run_subcalls(&input, 1, false, 1, &mut p);
+        let pb = assemble_parsed_batch(7, report.ok.into_iter().flat_map(|(_, v)| v));
+        let ids: Vec<u64> = pb.entries.iter().map(|e| e.id).collect();
+        assert_eq!(ids, (0..6).map(|i| 7 * 100_000 + i).collect::<Vec<_>>());
+        let msgs: Vec<&str> = pb.entries.iter().map(|e| e.message.as_str()).collect();
+        assert_eq!(msgs, vec!["a", "b", "c", "d", "e", "f"]);
+        // targettag 與 entry 一一對應
+        for (e, t) in pb.entries.iter().zip(pb.targettags.iter()) {
+            assert_eq!(t, &format!("T-{}", e.message));
+        }
+        assert_eq!(pb.seq, 7);
+    }
+
+    #[test]
+    fn subcall_ids_match_whole_batch_ids_when_no_errors() {
+        let input = lines(&["a", "b", "c", "d", "e"]);
+        let whole = {
+            let mut p = MockParser::new(0);
+            let r = run_subcalls(&input, 0, false, 1, &mut p);
+            assemble_parsed_batch(3, r.ok.into_iter().flat_map(|(_, v)| v))
+        };
+        for k in [1, 2, 3, 16] {
+            let mut p = MockParser::new(0);
+            let r = run_subcalls(&input, k, false, 1, &mut p);
+            let split = assemble_parsed_batch(3, r.ok.into_iter().flat_map(|(_, v)| v));
+            let a: Vec<(u64, &str)> = whole.entries.iter().map(|e| (e.id, e.message.as_str())).collect();
+            let b: Vec<(u64, &str)> = split.entries.iter().map(|e| (e.id, e.message.as_str())).collect();
+            assert_eq!(a, b, "k={k}");
+            assert_eq!(whole.targettags, split.targettags);
+        }
+    }
