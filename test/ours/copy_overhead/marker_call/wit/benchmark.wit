package local:marker-benchmark@0.1.0;

world benchmark {
    /// Empty synchronous callback, used to isolate the boundary cost.
    import noop-sign: func();

    /// Synchronous marker that reads Instant::now() in the Rust host.
    import time-sign: func();

    /// Control path: loop arithmetic without crossing into the host.
    export baseline: func(iterations: u32, seed: u64) -> u64;

    /// Identical arithmetic plus one empty host call per loop.
    export with-noop-sign: func(iterations: u32, seed: u64) -> u64;

    /// Identical arithmetic plus one timestamping host call per loop.
    export with-time-sign: func(iterations: u32, seed: u64) -> u64;
}
