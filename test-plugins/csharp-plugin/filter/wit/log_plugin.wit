package local:log-process@0.3.0;

interface pipeline-process {

    record log-entry {
        id: u64,
        timestamp: string,
        level: log-level,
        message: string,
        tags: list<tuple<string, string>>,
    }

    enum log-level {
        debug,
        info,
        warn,
        error,
        crit,
        alert,
        emerg,
    }

    variant plugin-error {
        invalid-input(string),
        processing-failed(string),
        config-error(string),
        unknown-id(u64),
        internal-error,
    }

    record filter-result {
        id: u64,
        keep: bool,
    }
}

world reduction-plugin {
    use pipeline-process.{log-entry, filter-result, plugin-error};

    import wasi:clocks/monotonic-clock@0.2.0;
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:io/error@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/streams@0.2.0;
    import wasi:cli/exit@0.2.0;
    import wasi:cli/stdin@0.2.0;
    import wasi:cli/stdout@0.2.0;
    import wasi:cli/stderr@0.2.0;
    import wasi:cli/terminal-input@0.2.0;
    import wasi:cli/terminal-output@0.2.0;
    import wasi:cli/terminal-stdin@0.2.0;
    import wasi:cli/terminal-stdout@0.2.0;
    import wasi:cli/terminal-stderr@0.2.0;
    import wasi:random/random@0.2.0;
    import wasi:random/insecure@0.2.0;
    import wasi:random/insecure-seed@0.2.0;

    export filter: func(
        struct-data: list<log-entry>
    ) -> result<list<filter-result>, plugin-error>;

    export report-usage: func() -> u64;
}
